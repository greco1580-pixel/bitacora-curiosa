# Base de datos (Vercel Postgres / Neon). Prisma necesita la connection
# string con pooling para runtime y, si usás Neon/Vercel Postgres, también
# la directa para migraciones. Si tu proveedor solo te da una, usá la misma
# en las dos variables.
DATABASE_URL="postgresql://usuario:password@host/basededatos?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://usuario:password@host/basededatos?sslmode=require"

# Mercado Pago — se completa en la próxima fase de desarrollo (integración
# de pago). Dejar los nombres ya listos para no tener que tocar el código.
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_PUBLIC_KEY=""
MERCADOPAGO_WEBHOOK_SECRET=""

# URL base del sitio, usada para armar las URLs de retorno de Mercado Pago
# y los metadatos Open Graph.
NEXT_PUBLIC_SITE_URL="https://bitacoracuriosa.com.ar"
